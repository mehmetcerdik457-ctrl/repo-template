# Copy to a local .env file only for development.
# Never commit real credentials. Empty values are intentional.

APP_ENV=development
APP_NAME=
LOG_LEVEL=INFO

# Model providers
OPENAI_API_KEY=
HUGGINGFACE_TOKEN=

# Database / state
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEON_DATABASE_URL=

# Deploy providers
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
VERCEL_TOKEN=
RAILWAY_TOKEN=

# Notifications / operations
SLACK_WEBHOOK_URL=

# Optional observability
DATADOG_API_KEY=
DATADOG_APP_KEY=
